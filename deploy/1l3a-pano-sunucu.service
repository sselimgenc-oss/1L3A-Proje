# Panoyu YALNIZ sunucunun kendi adresinde (127.0.0.1) sunar; dışarıya açık değildir. Telefondan/bilgisayardan SSH tüneli ile bakılır:
#   ssh -L 8080:127.0.0.1:8080 l3a@SUNUCU_IP   ->   tarayıcıda http://localhost:8080/pano.html
#   (l3a ile SSH için anahtar adımı: deploy/KURULUM.md §1)
[Unit]
Description=1L3A pano (yalnız localhost)
After=network.target 1l3a-paper.service
# İlk kurulumda motor dizini henüz açmadıysa hızlı yeniden denemeler start-limit'e takılıp kalıcı 'failed' bırakmasın
StartLimitIntervalSec=0

[Service]
User=l3a
Group=l3a
# durum/ alt dizinini de systemd açar (l3a sahipliğinde): motor açmadan önce başlasa bile chdir hatası olmaz
StateDirectory=1l3a-paper 1l3a-paper/durum
WorkingDirectory=/var/lib/1l3a-paper/durum
ExecStart=/opt/1l3a/.venv/bin/python -m http.server 8080 --bind 127.0.0.1 --directory /var/lib/1l3a-paper/durum
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
