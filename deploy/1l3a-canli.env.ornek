# /etc/1l3a-canli.env olarak kopyalayın: sahibi root, izin 600 (chmod 600 /etc/1l3a-canli.env). DEĞERLERİ YALNIZ SUNUCUDA doldurun; bu dosya repoda boş kalır.
# Her strateji = ayrı Binance hesabı (alt hesap) = ayrı anahtar çifti. Adlar /etc/1l3a-canli.json içindeki api_key_env / api_secret_env ile aynı olmalı.
BINANCE_API_KEY_S1=
BINANCE_API_SECRET_S1=
# BINANCE_API_KEY_S2=
# BINANCE_API_SECRET_S2=
# Gerçek para onayı: yalnız canlıya geçerken, bilerek "evet" yazın. Testnet/kuru için BOŞ bırakın.
CANLI_ONAY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
