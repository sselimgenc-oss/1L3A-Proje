# /etc/1l3a-pano.env olarak kopyalayın (chmod 600). Anahtarı ve şifreyi ASLA repoya/sohbete koymayın.
# Cloudflare: My Profile -> API Tokens -> Create Token -> "Edit Cloudflare Workers" şablonu.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
PANO_AD=1l3a-pano
# Pano şifresi (ZORUNLU, en az 16 karakter; kullanıcı adı sabit: 1l3a). Boşsa yayın yapılmaz.
# Üretmek için: openssl rand -base64 18   (çıktıyı şifre yöneticinize kaydedin; boşluk/tırnak kullanmayın)
PANO_SIFRE=
